<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  fox report-day autopilot: a per-user launchd agent (template). ops/install-autopilot.sh fills the two placeholders (REPO: the insurance-dashboard
  folder of the checkout; HOME) and installs it as ~/Library/LaunchAgents/com.fox.autopilot.plist. Do not load this file as is.
  It wakes pipeline/autopilot/tick.py on every quarter hour; the tick decides from ops/autopilot.toml and calendar.json whether to act
  (every 15 min inside filing windows on filing days 07:00-22:00, hourly otherwise, data.gov.il daily). A sleeping Mac runs one
  coalesced tick on wake. Nothing it runs deploys, pushes or commits.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.fox.autopilot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__REPO__/pipeline/autopilot/tick.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Minute</key><integer>0</integer></dict>
    <dict><key>Minute</key><integer>15</integer></dict>
    <dict><key>Minute</key><integer>30</integer></dict>
    <dict><key>Minute</key><integer>45</integer></dict>
  </array>
  <key>RunAtLoad</key>
  <false/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin:__HOME__/.local/bin</string>
    <key>LANG</key>
    <string>en_US.UTF-8</string>
    <key>PYTHONIOENCODING</key>
    <string>utf-8</string>
    <key>FOX_AUTOPILOT_HOME</key>
    <string>__HOME__/.cache/fox/autopilot</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/fox-autopilot/tick.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/fox-autopilot/tick.log</string>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>5</integer>
  <key>ExitTimeOut</key>
  <integer>60</integer>
</dict>
</plist>
