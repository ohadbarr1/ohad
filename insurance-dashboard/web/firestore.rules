rules_version = '2';
// fox · cross-device sync (lib/sync.ts, lib/firebase.ts). One document per stored key under users/{uid}/kv/{key}:
//   { v: string | null  (the value as JSON text; null = removed), t: int (ms, last write), d: string (device id) }
// Only the signed-in owner reads or writes their own documents; nothing else in the database is reachable.
// Last write wins is enforced here: a write with an older stamp than the stored one is refused (the client then pulls the newer one).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/kv/{key} {
      function owner() {
        return request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true;
      }
      function valid() {
        let e = request.resource.data;
        return e.keys().hasOnly(['v', 't', 'd']) && e.keys().hasAll(['v', 't', 'd'])
          && (e.v == null || (e.v is string && e.v.size() <= 262144))      // 256 KB of JSON per key (the chart book is the largest)
          && e.t is int && e.t > 1700000000000 && e.t <= request.time.toMillis() + 600000   // no stamps from the future (10 min clock skew)
          && e.d is string && e.d.size() > 0 && e.d.size() <= 32
          && key.size() <= 400;
      }
      allow read: if owner();
      allow create: if owner() && valid();
      allow update: if owner() && valid() && request.resource.data.t >= resource.data.t;
      allow delete: if false;   // removal is a tombstone (v = null), so it syncs like any other write
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
