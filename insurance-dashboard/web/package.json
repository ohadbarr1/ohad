{
  "name": "insurance-research-terminal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "cd .. && ./deploy.sh",
    "check": "cd .. && ./deploy.sh --check-only",
    "routes": "node --experimental-websocket scripts/route-check.mjs",
    "test:e2e": "playwright test",
    "test:schemas": "python3 ../pipeline/check_schemas.py",
    "test:sync": "node scripts/sync-test.mjs"
  },
  "dependencies": {
    "@fontsource/heebo": "5.3.0",
    "echarts": "^5.5.1",
    "firebase": "12.19.0",
    "pdfjs-dist": "4.10.38",
    "pptxgenjs": "4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
