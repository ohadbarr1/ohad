{
  "name": "insurance-research-terminal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "cd .. && ./deploy.sh",
    "check": "cd .. && ./deploy.sh --check-only",
