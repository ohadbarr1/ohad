    "test:scenarios": "node scripts/scenarios-test.mjs",
    "test:regulation": "node scripts/regulation-test.mjs",
    "test:warroom": "node scripts/warroom-test.mjs",
    "test:capital": "node scripts/capital-test.mjs",
    "test:forward": "node scripts/forward-test.mjs",
    "test:pnc": "node scripts/pnc-test.mjs",
    "test:fragility": "node scripts/fragility-test.mjs",
    "test:consolidation": "node scripts/consolidation-test.mjs",
    "test:answers": "node scripts/answers-test.mjs",
    "test:brief": "node scripts/brief-test.mjs",
    "test:watch": "node scripts/watch-test.mjs",
    "test:deliver": "node scripts/deliver-test.mjs",
    "test:fundscalc": "node scripts/funds-calc-test.mjs",
    "test:search": "node scripts/search-test.mjs",
