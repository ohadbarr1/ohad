{
 "$comment": "fox data contracts (lane 2H, ws6 W6-15). One file, read by web/src/lib/schema.ts (dev: full check of every fetched file; production: a sampled check that turns a renamed key into a friendly error) and by pipeline/check_schemas.py (the `schemas` check of pipeline/gate.py, full check of every built file). Keywords: type, enum, pattern, properties, required, additionalProperties, items, prefixItems, minItems, $ref. `files` maps a path under web/public/data to a schema; the first matching pattern wins (* = any characters except /).",
 "files": [
  {
   "pattern": "companies/index.json",
   "schema": "registry"
  },
  {
   "pattern": "companies/*.docs.json",
   "schema": "docs"
  },
  {
   "pattern": "companies/*.price.json",
   "schema": "price"
  },
  {
   "pattern": "companies/*.notes.json",
   "schema": "notes"
  },
  {
   "pattern": "companies/*.json",
   "schema": "workbook"
  },
  {
   "pattern": "peers/registry.json",
   "schema": "peersRegistry"
  },
  {
   "pattern": "peers/m/*.json",
   "schema": "peersMetric"
  },
  {
   "pattern": "lens.json",
   "schema": "lens"
  },
  {
   "pattern": "kpi.json",
   "schema": "kpi"
  },
  {
   "pattern": "market_home.json",
   "schema": "market"
  },
  {
   "pattern": "market.json",
   "schema": "market"
  },
  {
   "pattern": "csm/facts/*.json",
   "schema": "csmFacts"
  },
  {
   "pattern": "csm/summary.json",
   "schema": "csmSummary"
  },
  {
   "pattern": "csm/capital.json",
   "schema": "csmCapital"
  },
  {
   "pattern": "csm/rates.json",
   "schema": "csmRows"
  },
  {
   "pattern": "csm/sens.json",
   "schema": "csmRows"
  },
  {
   "pattern": "search/entities.json",
   "schema": "searchEntities"
  },
  {
   "pattern": "search/docs.json",
   "schema": "searchDocs"
  },
  {
   "pattern": "ifrs.json",
   "schema": "ifrsIndex"
  },
  {
   "pattern": "ifrs_*.json",
   "schema": "ifrsFacts"
  },
  {
   "pattern": "ifrs/*/*.json",
   "schema": "ifrsFacts"
  },
  {
   "pattern": "macro/macro.json",
   "schema": "macro"
  },
  {
   "pattern": "calendar.json",
   "schema": "calendar"
  },
  {
   "pattern": "funds.json",
   "schema": "funds"
  },
  {
   "pattern": "funds/cat.json",
   "schema": "fundCats"
  },
  {
   "pattern": "funds/*.json",
   "schema": "fundHist"
  },
  {
   "pattern": "series/index.json",
   "schema": "rangeIndex"
  },
  {
   "pattern": "series/*.json",
   "schema": "series"
  },
  {
   "pattern": "sop/index.json",
   "schema": "sopIndex"
  },
  {
   "pattern": "sop/*.json",
   "schema": "sop"
  },
  {
   "pattern": "filings_latest.json",
   "schema": "filingsLatest"
  },
  {
   "pattern": "qa.json",
   "schema": "qa"
  },
  {
   "pattern": "coverage.json",
   "schema": "coverage"
  },
  {
   "pattern": "consistency.json",
   "schema": "consistency"
  },
  {
   "pattern": "autopilot/status.json",
   "schema": "autopilotStatus"
  }
 ],
 "$defs": {
  "period": {
   "type": "string",
   "pattern": "^\\d{4}(Q[1-4]|FY|H[12])$"
  },
  "date": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}"
  },
  "month": {
   "type": "integer"
  },
  "num": {
   "type": [
    "number",
    "null"
   ]
  },
  "nums": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/num"
   }
  },
  "doc": {
   "type": "object",
   "required": [
    "id",
    "date",
    "type",
    "period",
    "url"
   ],
   "properties": {
    "id": {
     "type": "integer"
    },
    "date": {
     "$ref": "#/$defs/date"
    },
    "type": {
     "enum": [
      "annual",
      "quarterly",
      "presentation",
      "solvency"
     ]
    },
    "period": {
     "$ref": "#/$defs/period"
    },
    "title": {
     "type": "string"
    },
    "pages": {
     "type": [
      "integer",
      "null"
     ]
    },
    "en": {
     "type": "boolean"
    },
    "url": {
     "type": "string"
    }
   }
  },
  "registry": {
   "type": "array",
   "minItems": 17,
   "items": {
    "type": "object",
    "required": [
     "id",
     "name_he",
     "kind",
     "market_group",
     "has_financials",
     "docs",
     "has_price"
    ],
    "properties": {
