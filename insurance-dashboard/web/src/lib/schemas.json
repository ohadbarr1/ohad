       "string",
       "null"
      ]
     },
     "maya_id": {
      "type": "integer"
     },
     "has_financials": {
      "type": "boolean"
     },
     "docs": {
      "type": "integer"
     },
     "has_price": {
      "type": "boolean"
     },
     "filings": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "period",
        "url"
       ],
       "properties": {
        "url": {
         "type": [
          "string",
          "null"
         ]
        },
        "pages": {
         "type": [
          "integer",
          "null"
         ]
        }
       }
      }
     }
    }
   }
  },
  "docs": {
   "type": "object",
   "required": [
    "docs"
   ],
   "properties": {
    "source": {
     "type": "string"
    },
    "docs": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/doc"
     }
    }
   }
  },
  "price": {
   "type": "object",
   "required": [
    "ticker",
