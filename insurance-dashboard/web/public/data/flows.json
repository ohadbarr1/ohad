קרנות ענפיות ואחרות","method":{"cell":"תא = סכום מסלולי הקבוצה במוצר באותו חודש, כפי שכל מסלול מפורסם (funds/<k>.json). המוצר: לפי הקטגוריה של המסלול באותו חודש (ct). הקבוצה: לפי החברה המנהלת בחודש האחרון של המסלול (funds.json / closed.json grp); מסלול שעבר בין קבוצות משויך לקבוצה האחרונה שלו בכל חודשיו","n":"מספר המסלולים שדיווחו נכסים בחודש","nf":"מספר המסלולים שדיווחו הפקדות, משיכות והעברות בחודש (רק הם נכנסים לתזרימים)","a":"נכסים: סכום TOTAL_ASSETS","af":"נכסי המסלולים שדיווחו תזרימים; af ÷ a = כיסוי התזרימים","dep":"הפקדות: סכום DEPOSITS","wd":"משיכות: סכום WITHDRAWLS (חיובי; מופחת בצבירה)","tr":"ניוד נטו: סכום INTERNAL_TRANSFERS (העברות נכנסות פחות יוצאות; הרשות מפרסמת נטו בלבד, לא את שני הצדדים)","org":"צבירה אורגנית = הפקדות − משיכות","net":"צבירה נטו = הפקדות − משיכות + ניוד נטו","nd":"NET_MONTHLY_DEPOSITS כפי שפורסם (סכום); אמור להשתוות לצבירה נטו","mig":"נדידה פנימית: Σ min(סך ההעברות החיוביות, סך ההעברות השליליות בערך מוחלט) של מסלולי הקבוצה באותו מוצר ובאותו חודש: כסף שעבר בין מסלולי הקבוצה (כמו funds_lib.migration, ברמת הקבוצה ובחודש בודד). מקוזז כבר בסכום הקבוצה, ולכן אינו משנה את הניוד נטו שלה; מוצג כדי שיראו כמה מהתנועה ברמת המסלול פנימית. בקרנות ענפיות ואחרות: לכל חברה מנהלת בנפרד. העברות בין מוצרים שונים של אותה קבוצה אינן מנוכות: הרשות מפרסמת נטו לכל מסלול, ותנועות הפוכות בין מוצרים באותו חודש הן ברובן העברות לגופים אחרים","dd":"הפקדות לקרן ברירת מחדל: סכום DEPOSITS של מסלולי קרן שהייתה קרן נבחרת (ברירת מחדל) באותו חודש, לפי תקופות ההליכים ב-funds/default.json; הפקדות לשאר מסלולי הקבוצה = dep − dd. רק פנסיה מקיפה. עמיתים שהצטרפו בתקופת ההליך ממשיכים להפקיד אחריה; ההפקדות האלה אינן מופרדות","dt":"ניוד לקרן ברירת מחדל: סכום INTERNAL_TRANSFERS של אותם מסלולים באותם חודשים, רק כשהוא חיובי (max(0, Σ)): עמיתים שהצטרפו דרך ברירת המחדל ומעבירים אליה חיסכון קודם. מנוכה מהניוד התחרותי, גם כשחלקו בחירה של העמית; ניוד נטו שלילי של קרן ברירת מחדל (עמיתים שעזבו) נשאר בניוד התחרותי","cl":"סגירת מסלולים: העברה יוצאת של מסלול בחודש שבו נכסיו ירדו מתחת ל-5% מהחודש הקודם (או בחודש האחרון שלו), כשהיא ≥ 50% מנכסי החודש הקודם; רק החלק שלא קוזז בתוך הקבוצה: max(Σ העברות הסגירה, min(ניוד נטו, 0)). מיזוג מסלולים שהמסלול הקולט לא רשם כהעברה נכנסת","comp":"ניוד תחרותי = ניוד נטו − ניוד לקרן ברירת מחדל − סגירת מסלולים (tr − dt − cl). הנדידה הפנימית כבר מקוזזת בניוד נטו של הקבוצה","res":"לא מוסבר: Σ (נכסים − נכסי החודש הקודם − NET_MONTHLY_DEPOSITS − נכסי החודש הקודם × תשואה חודשית ברוטו ÷ 100) על מסלולים שדיווחו בשני החודשים. סכום גדול: מיזוג, העברת ניהול או הפרש דיווח; אומדן (התשואה ברוטו, לפני דמי ניהול)","rk":"מקום בניוד התחרותי בין הקבוצות במוצר באותו חודש (1 = הגבוה ביותר); בלי קרנות ענפיות ואחרות; ערכים שווים חולקים מקום","win":"3M / 12M: סכום שלושה / שנים-עשר חודשים רצופים שמסתיימים בחודש; חודש חסר = אין ערך","round":"כל סכום מעוגל ל-0.1 מיליון ש\"ח אחרי הסכימה; org, net ו-comp מחושבים מהרכיבים המעוגלים, ולכן הזהויות מתקיימות בדיוק בקובץ","sig":"אות זרימה: צבירה נטו של המסלול (NET_MONTHLY_DEPOSITS) ב-3 וב-12 החודשים שמסתיימים ב-asof, רק כשכל החודשים פורסמו; בקטגוריה (מוצר | מסלול, היום): מספר המסלולים הפעילים עם נכסים ועם ערך לחלון, וכמה מהם בצבירה נטו חיובית","fee":"דמי ניהול מצבירה, ממוצע בפועל של המסלול (AVG_ANNUAL_MANAGEMENT_FEE) כפי שפורסם בכל חודש, בלי השלמה. fee = asof; fee12 = 12 חודשים קודם; d12 = ההפרש בנקודות בסיס; log = חודשים ב-36 האחרונים שבהם השיעור זז ב-5 נ\"ב או יותר מהחודש שפורסם לפניו: [חודש, קודם, חדש]. ממוצע בפועל של המסלול, לא מה שחוסך מסוים משלם"},"coverage":{"prods":[{"id":"pm","assets_from":201110,"flows_from":201606,"dep_wd":true,"tr_split":false,"thin_n":56,"thin":[201110,201111,201112,201201,201202,201203,201204,201205,201206,201207,201208,201209],"note":"הפקדות, משיכות וניוד נטו לכל מסלול; העברות נכנסות ויוצאות בנפרד אינן מפורסמות"},{"id":"pk","assets_from":201203,"flows_from":201606,"dep_wd":true,"tr_split":false,"thin_n":51,"thin":[201203,201204,201205,201206,201207,201208,201209,201210,201211,201212,201301,201302],"note":"הפקדות, משיכות וניוד נטו לכל מסלול; העברות נכנסות ויוצאות בנפרד אינן מפורסמ