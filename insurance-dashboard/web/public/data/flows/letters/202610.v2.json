 לא רשם כהעברה נכנסת"},{"k":"mig","he":"נדידה פנימית","def":"נדידה פנימית: Σ min(סך ההעברות החיוביות, סך ההעברות השליליות בערך מוחלט) של מסלולי הקבוצה באותו מוצר ובאותו חודש: כסף שעבר בין מסלולי הקבוצה (כמו funds_lib.migration, ברמת הקבוצה ובחודש בודד). מקוזז כבר בסכום הקבוצה, ולכן אינו משנה את הניוד נטו שלה; מוצג כדי שיראו כמה מהתנועה ברמת המסלול פנימית. בקרנות ענפיות ואחרות: לכל חברה מנהלת בנפרד. העברות בין מוצרים שונים של אותה קבוצה אינן מנוכות: הרשות מפרסמת נטו לכל מסלול, ותנועות הפוכות בין מוצרים באותו חודש הן ברובן העברות לגופים אחרים"},{"k":"org","he":"צבירה אורגנית","def":"צבירה אורגנית = הפקדות − משיכות"},{"k":"net","he":"צבירה נטו","def":"צבירה נטו = הפקדות − משיכות + ניוד נטו"}],"compare":["רמת הצבירה: מסלול, קופה, חברה מנהלת או קבוצה. נדידה פנימית מתקזזת רק כשמסכמים את כל מסלולי הקבוצה במוצר; ב-10/26 עברו כך ⁦₪6.9⁩ מיליארד בין מסלולים של אותה קבוצה.","קרנות ברירת מחדל: ב-10/26 ניוד לקרן ברירת מחדל היה ⁦+₪934⁩ מיליון. fox מנכה אותו מהניוד התחרותי; פרסום שאינו מנכה יראה את הזוכה במכרז גבוה יותר.","סגירה ומיזוג של מסלולים: ⁦₪0⁩ מיליון ב-10/26, מנוכים מהניוד התחרותי.","המדד: ניוד (העברות בין גופים) מול צבירה (הפקדות פחות משיכות, ועוד ניוד). שני מספרים שונים לאותו גוף באותו חודש.","גרסת הנתונים: הרשות מעדכנת את קבצי החודש. fox קיבל את 10/26 ב-25.11.26; כל גרסה של המכתב נושאת את יום הבנייה."]},"method":{"cell":"תא = סכום מסלולי הקבוצה במוצר באותו חודש, כפי שכל מסלול מפורסם (funds/<k>.json). המוצר: לפי הקטגוריה של המסלול באותו חודש (ct). הקבוצה: לפי החברה המנהלת בחודש האחרון של המסלול (funds.json / closed.json grp); מסלול שעבר בין קבוצות משויך לקבוצה האחרונה שלו בכל חודשיו","a":"נכסים: סכום TOTAL_ASSETS","dep":"הפקדות: סכום DEPOSITS","wd":"משיכות: סכום WITHDRAWLS (חיובי; מופחת בצבירה)","tr":"ניוד נטו: סכום INTERNAL_TRANSFERS (העברות נכנסות פחות יוצאות; הרשות מפרסמת נטו בלבד, לא את שני הצדדים)","org":"צבירה אורגנית = הפקדות − משיכות","net":"צבירה נטו = הפקדות − משיכות + ניוד נטו","mig":"נדידה פנימית: Σ min(סך ההעברות החיוביות, סך ההעברות השליליות בערך מוחלט) של מסלולי הקבוצה באותו מוצר ובאותו חודש: כסף שעבר בין מסלולי הקבוצה (כמו funds_lib.migration, ברמת הקבוצה ובחודש בודד). מקוזז כבר בסכום הקבוצה, ולכן אינו משנה את הניוד נטו שלה; מוצג כדי שיראו כמה מהתנועה ברמת המסלול פנימית. בקרנות ענפיות ואחרות: לכל חברה מנהלת בנפרד. העברות בין מוצרים שונים של אותה קבוצה אינן מנוכות: הרשות מפרסמת נטו לכל מסלול, ותנועות הפוכות בין מוצרים באותו חודש הן ברובן העברות לגופים אחרים","dt":"ניוד לקרן ברירת מחדל: סכום INTERNAL_TRANSFERS של אותם מסלולים באותם חודשים, רק כשהוא חיובי (max(0, Σ)): עמיתים שהצטרפו דרך ברירת המחדל ומעבירים אליה חיסכון קודם. מנוכה מהניוד התחרותי, גם כשחלקו בחירה של העמית; ניוד נטו שלילי של קרן ברירת מחדל (עמיתים שעזבו) נשאר בניוד התחרותי","cl":"סגירת מסלולים: העברה יוצאת של מסלול בחודש שבו נכסיו ירדו מתחת ל-5% מהחודש הקודם (או בחודש האחרון שלו), כשהיא ≥ 50% מנכסי החודש הקודם; רק החלק שלא קוזז בתוך הקבוצה: max(Σ העברות הסגירה, min(ניוד נטו, 0)). מיזוג מסלולים שהמסלול הקולט לא רשם כהעברה נכנסת","comp":"ניוד תחרותי = ניוד נטו − ניוד לקרן ברירת מחדל − סגירת מסלולים (tr − dt − cl). הנדידה הפנימית כבר מקוזזת בניוד נטו של הקבוצה","rk":"מקום בניוד התחרותי בין הקבוצות במוצר באותו חודש (1 = הגבוה ביותר); בלי קרנות ענפיות ואחרות; ערכים שווים חולקים מקום"},"coverage":{"tr_split":"הרשות מפרסמת לכל מסלול העברות נטו בלבד (INTERNAL_TRANSFERS); העברות נכנסות והעברות יוצאות בנפרד אינן מפורסמות לאף מוצר ולאף תקופה, ולכן אינן בקובץ","group":"שיוך לקבוצה לפי החברה המנהלת בחודש האחרון של המסלול: מסלול שעבר בין קבוצות (מכירה, מיזוג חברות) מופיע בקבוצה האחרונה שלו גם בחודשים שלפני המעבר","default":"השפעת ברירת המחדל: רק פנסיה מקיפה; שיוך הזוכה למסלולים לפי שם הקרן (funds/default.json, map = inferred)"},"figs":{"win.comp":["ניוד תחרותי, כל המוצרים · כלל",3827.3],"lose.comp":["ניוד תחרותי, כל המוצרים · אלטשולר שחם",-3425.8],"pm.tot.tr":["פנסיה מקיפה · ניוד נטו",1892.9],"pm.tot.comp":["פנסיה מקיפה · ניוד תחרותי",959.2],"pm.tot.dt":["פנסיה מקיפה · לקרנות ברירת מחדל",933.7],"pm.tot.cl":["פנסיה מקיפה · סגירת מסלולים",0.0],"pm.tot.mig":["פנסיה מקיפה