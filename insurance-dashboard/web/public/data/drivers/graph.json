{"meta":{"built":"2026-10-23","v":1,"about":"A1 Driver Graph: nodes, equations and edges. Per-company calibration: drivers/<company>.json. Propagation: web/src/lib/drivers.ts.","methods":{"identity":"an accounting identity over printed or regulator inputs","regression":"OLS on fox's own history (n, window, R², t printed)","disclosure":"the company's printed sensitivity (report + page), read as the stress lab reads it: between the disclosed points, clamped beyond","assumption":"a labelled modelling choice; quality always low"},"quality":{"high":"identity over printed inputs; regression with n >= 36 months (12 quarters), R² >= 0.7, |t| >= 2; disclosure at most 24 months before its base","medium":"R² >= 0.4, or a disclosure 25–36 months old, or an identity over labelled M3 assumptions (duration, ke, average margin)","low":"a labelled assumption, a weak or short fit, or a disclosure older than 36 months","missing":"no free public input publishes it; the reason is written on the edge"},"units":{"money":"NIS millions","rates":"percent","shocks":"bp (rates, fees, spreads), % (equities, insurance risks, cost), pp (CPI, net flow % of assets a year)"}},"shocks":[{"k":"policy","he":"ריבית בנק ישראל","unit":"bp","range":[-200,200]},{"k":"y10","he":"תשואת 10 שנים (עקום חסר סיכון)","unit":"bp","range":[-200,200]},{"k":"eq","he":"מניות","unit":"%","range":[-40,30]},{"k":"credit","he":"מרווחי אשראי","unit":"bp","range":[-100,300]},{"k":"cpi","he":"מדד המחירים לצרכן","unit":"pp","range":[-2,6]},{"k":"flow","he":"צבירה נטו (% מהנכסים לשנה)","unit":"pp","range":[-10,10]},{"k":"fee","he":"שחיקת דמי ניהול על צבירה","unit":"bp","range":[0,10]},{"k":"cost","he":"אינפלציית הוצאות (מעבר למדד)","unit":"%","range":[-10,20]},{"k":"mortality","he":"שיעורי תמותה","unit":"%","range":[-20,20]},{"k":"morbidity","he":"שיעורי תחלואה","unit":"%","range":[-20,20]},{"k":"lapse","he":"שיעורי ביטולים","unit":"%","range":[-30,30]}],"nodes":[{"id":"aum","he":"נכסים מנוהלים (לכל מוצר)","unit":"מיליוני ש\"ח","kind":"line"},{"id":"r_market","he":"תשואת התיק","unit":"%","kind":"driver"},{"id":"net_flow","he":"צבירה נטו: אורגנית + ניוד","unit":"מיליוני ש\"ח","kind":"line"},{"id":"organic","he":"צבירה אורגנית (הפקדות פחות משיכות)","unit":"מיליוני ש\"ח","kind":"line"},{"id":"transfers","he":"ניוד נטו","unit":"מיליוני ש\"ח","kind":"line"},{"id":"fee_yield","he":"תשואת דמי ניהול על נכסים","unit":"%","kind":"driver"},{"id":"revenue","he":"הכנסות מדמי ניהול, חיסכון ארוך טווח","unit":"מיליוני ש\"ח","kind":"output"},{"id":"opex","he":"הוצאות: שיווק ומכירה + הנהלה וכלליות","unit":"מיליוני ש\"ח","kind":"line"},{"id":"op_profit","he":"רווח תפעולי, חיסכון ארוך טווח (מגזרי)","unit":"מיליוני ש\"ח","kind":"output"},{"id":"npv_op","he":"ערך נוכחי של רווח תפעולי מניוד","unit":"מיליוני ש\"ח","kind":"line"},{"id":"csm","he":"יתרת CSM (נטו, קבוצה)","unit":"מיליוני ש\"ח","kind":"output"},{"id":"csm_release","he":"שחרור CSM לרווח","unit":"מיליוני ש\"ח","kind":"line"},{"id":"isr","he":"רווח משירותי ביטוח","unit":"מיליוני ש\"ח","kind":"line"},{"id":"inv_income","he":"רווח מהשקעות ומימון, נטו","unit":"מיליוני ש\"ח","kind":"line"},{"id":"financing","he":"הוצאות מימון על חוב","unit":"מיליוני ש\"ח","kind":"line"},{"id":"tax","he":"שיעור מס","unit":"%","kind":"driver"},{"id":"net_profit","he":"רווח נקי לבעלי המניות","unit":"מיליוני ש\"ח","kind":"output"},{"id":"equity","he":"הון לבעלי המניות (ממוצע)","unit":"מיליוני ש\"ח","kind":"line"},{"id":"roe","he":"תשואה להון","unit":"%","kind":"output"},{"id":"ke","he":"מחיר ההון","unit":"%","kind":"driver"},{"id":"pb","he":"מכפיל הון מוצדק","unit":"x","kind":"output"},{"id":"own_funds","he":"הון עצמי לכושר פירעון","unit":"מיליוני ש\"ח","kind":"line"},{"id":"scr","he":"הון נדרש לכושר פירעון (SCR)","unit":"מיליוני ש\"ח","kind":"line"},{"id":"solv_w","he":"יחס כושר פירעון, עם הוראות מעבר","unit":"%","kind":"output"},{"id":"solv_wo","he":"יחס כושר פירעון, ללא הוראות מעבר","unit":"%","kind":"output"},{"id":"dist_capital","he":"הון עודף מעל יעד הדירקטוריון","unit":"מיליוני ש\"ח","kind":"output"},{"id":"div_capacity","he":"עודף מעל סף חלוקת הדיבידנד","unit":"מיליוני ש\"ח","kind":"output"}],"equations":[{"id":"aum","out":"aum","text":"AUM(t) = AUM(t−1) × (1 + r_market) + net_flow","kind":"identity"},{"id":"net_flow","out":"net_flow","text":"net_flow = organic + transfers","kind":"identity"},{"id":"revenue","out":"revenue","text":"revenue = Σ(product) avgAUM × fee_yield","kind":"identity"},{"id":"opex","out":"opex","text":"opex = fixed + variable × avgAUM (headcount: not published per segment)","kind":"regression"},{"id":"op_profit","out":"op_profit","text":"op_profit = revenue − opex","kind":"identity"},{"id":"npv_op","out":"npv_op","text":"NPV = F × m ÷ 100 × a(D, ke); m = fee_yield × (1 − opex ÷ revenue) (M3, flow_npv.json)","kind":"identity"},{"id":"isr","out":"isr","text":"ISR = CSM_release + RA_release ± experience (only CSM_release is modelled; the rest is the printed residual)","kind":"identity"},{"id":"csm_release","out":"csm_release","text":"CSM_release(next year) = CSM × release rate (FY'25: release ÷ average CSM, gross life + health)","kind":"identity"},{"id":"inv_income","out":"inv_income","text":"inv_income = nostro × return (shocks: the printed IFRS 17 profit sensitivities, after tax)","kind":"disclosure"},{"id":"financing","out":"financing","text":"Δfinancing = CPI-linked principal × ΔCPI + next-12-month maturities × Δyield (refinanced)","kind":"identity"},{"id":"net_profit","out":"net_profit","text":"net_profit = (op_profit + ISR + inv_income − financing) × (1 − tax); Δ = Σ Δ(pre-tax) × (1 − tax) + Δ(printed, after tax)","kind":"identity"},{"id":"roe","out":"roe","text":"ROE = net_profit ÷ average equity","kind":"identity"},{"id":"ke","out":"ke","text":"ke = rf (BoI 10Y) + β × ERP (valuation.ts ASSUME0)","kind":"identity"},{"id":"pb","out":"pb","text":"justified P/B = (ROE − g) ÷ (ke − g)","kind":"identity"},{"id":"solv","out":"solv_w","text":"solvency = own_funds ÷ SCR; Δ = Σ printed Δpp per shock (no diversification credit)","kind":"disclosure"},{"id":"dist","out":"dist_capital","text":"dist_capital = own_funds − SCR × board_target = SCR × (solvency − target) ÷ 100","kind":"identity"},{"id":"div","out":"div_capacity","text":"div_capacity = SCR × (solvency − dividend threshold) ÷ 100","kind":"identity"}],"edges":[{"id":"fee.op","from":"fee","to":"op_profit","sign":-1,"unit":"מיליוני ש״ח לשנה לכל 1 נ״ב","he":"שחיקת דמי ניהול ← רווח תפעולי"},{"id":"tr.npv","from":"transfers","to":"npv_op","sign":0,"unit":"מיליוני ש״ח ערך נוכחי לכל מיליארד ש״ח","he":"ניוד נטו ← ערך נוכחי של רווח תפעולי"},{"id":"eq.aum","from":"eq","to":"aum","sign":1,"unit":"% מהנכסים לכל 1% במניות","he":"מניות ← נכסים מנוהלים"},{"id":"y10.aum","from":"y10","to":"aum","sign":-1,"unit":"% מהנכסים לכל 100 נ״ב","he":"תשואת 10 שנים ← נכסים מנוהלים"},{"id":"aum.rev","from":"aum","to":"revenue","sign":1,"unit":"מיליוני ש״ח הכנסות לשנה לכל מיליארד ש״ח נכסים","he":"נכסים ← הכנסות"},{"id":"aum.opex","from":"aum","to":"opex","sign":1,"unit":"מיליוני ש״ח הוצאות לשנה לכל מיליארד ש״ח נכסים","he":"נכסים ← הוצאות (רכיב משתנה)"},{"id":"cpi.opex","from":"cpi","to":"opex","sign":1,"unit":"מיליוני ש״ח לשנה לכל 1 נ״א במדד","he":"מדד ← הוצאות"},{"id":"cpi.fin","from":"cpi","to":"financing","sign":1,"unit":"מיליוני ש״ח לשנה לכל 1 נ״א במדד","he":"מדד ← מימון (קרן צמודה)"},{"id":"y10.fin","from":"y10","to":"financing","sign":1,"unit":"מיליוני ש״ח לשנה לכל 100 נ״ב","he":"תשואה ← מימון (מחזור פירעונות 12 חודשים)"},{"id":"policy.fin","from":"policy","to":"financing","sign":1,"unit":"מיליוני ש״ח לשנה לכל 100 נ״ב","he":"ריבית בנק ישראל ← מימון"},{"id":"op.np","from":"op_profit","to":"net_profit","sign":1,"unit":"מיליוני ש״ח לכל מיליון ש״ח לפני מס","he":"רווח לפני מס ← רווח נקי (1 − מס)"},{"id":"csm.isr","from":"csm","to":"csm_release","sign":1,"unit":"מיליוני ש״ח שחרור בשנה לכל מיליון ש״ח CSM","he":"CSM ← שחרור לרווח"},{"id":"np.roe","from":"net_profit","to":"roe","sign":1,"unit":"נ״א לכל 100 מיליוני ש״ח","he":"רווח נקי ← תשואה להון"},{"id":"y10.ke","from":"y10","to":"ke","sign":1,"unit":"נ״א לכל 100 נ״ב","he":"תשואה ← מחיר ההון"},{"id":"roe.pb","from":"roe","to":"pb","sign":1,"unit":"x לכל 1 נ״א","he":"תשואה להון ← מכפיל הון מוצדק"},{"id":"solv.dist","from":"solv_w","to":"dist_capital","sign":1,"unit":"מיליוני ש״ח לכל 1 נ״א","he":"יחס כושר פירעון ← הון עודף"},{"id":"y10.solv_w","from":"y10","to":"solv_w","sign":0,"unit":"נ״א ביחס","he":"ריבית ← כושר פירעון (עם הוראות מעבר)"},{"id":"y10.solv_wo","from":"y10","to":"solv_wo","sign":0,"unit":"נ״א ביחס","he":"ריבית ← כושר פירעון (ללא הוראות מעבר)"},{"id":"eq.solv_w","from":"eq","to":"solv_w","sign":0,"unit":"נ״א ביחס","he":"מניות ← כושר פירעון (עם)"},{"id":"eq.solv_wo","from":"eq","to":"solv_wo","sign":0,"unit":"נ״א ביחס","he":"מניות ← כושר פירעון (ללא)"},{"id":"credit.solv_w","from":"credit","to":"solv_w","sign":0,"unit":"נ״א ביחס","he":"מרווחי אשראי ← כושר פירעון"},{"id":"mortality.solv_w","from":"mortality","to":"solv_w","sign":0,"unit":"נ״א ביחס","he":"תמותה ← כושר פירעון"},{"id":"morbidity.solv_w","from":"morbidity","to":"solv_w","sign":0,"unit":"נ״א ביחס","he":"תחלואה ← כושר פירעון"},{"id":"lapse.solv_w","from":"lapse","to":"solv_w","sign":0,"unit":"נ״א ביחס","he":"ביטולים ← כושר פירעון"},{"id":"y10.csm","from":"y10","to":"csm","sign":0,"unit":"מיליוני ש\"ח","he":"ריבית ← CSM"},{"id":"eq.csm","from":"eq","to":"csm","sign":0,"unit":"מיליוני ש\"ח","he":"מניות ← CSM"},{"id":"credit.csm","from":"credit","to":"csm","sign":0,"unit":"מיליוני ש\"ח","he":"מרווחי אשראי ← CSM"},{"id":"mortality.csm","from":"mortality","to":"csm","sign":0,"unit":"מיליוני ש\"ח","he":"תמותה ← CSM"},{"id":"morbidity.csm","from":"morbidity","to":"csm","sign":0,"unit":"מיליוני ש\"ח","he":"תחלואה ← CSM"},{"id":"lapse.csm","from":"lapse","to":"csm","sign":0,"unit":"מיליוני ש\"ח","he":"ביטולים ← CSM"},{"id":"y10.np","from":"y10","to":"net_profit","sign":0,"unit":"מיליוני ש\"ח","he":"ריבית ← רווח נקי (גילוי, אחרי מס)"},{"id":"eq.np","from":"eq","to":"net_profit","sign":0,"unit":"מיליוני ש\"ח","he":"מניות ← רווח נקי (גילוי, אחרי מס)"},{"id":"mortality.np","from":"mortality","to":"net_profit","sign":0,"unit":"מיליוני ש\"ח","he":"תמותה ← רווח נקי"},{"id":"morbidity.np","from":"morbidity","to":"net_profit","sign":0,"unit":"מיליוני ש\"ח","he":"תחלואה ← רווח נקי"}]}