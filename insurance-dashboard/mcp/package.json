{
  "name": "fox-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Ask fox: read-only MCP server over the published fox research data (web/public/data). No LLM calls inside.",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "fox-mcp": "dist/server.mjs" },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/server.mjs",
    "eval": "node build.mjs && node dist/eval.mjs",
    "test": "node build.mjs && node dist/eval.mjs && node dist/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "esbuild": "0.28.1",
    "typescript": "5.6.3"
  }
}
